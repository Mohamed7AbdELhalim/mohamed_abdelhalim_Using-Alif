# نظام إدارة معلومات الطلاب (Student Inforمation مanageمent Systeم) [...]
# هذا مثال توضيحي يوضح استخدام الميزات المذكورة في لغة ألف5
# لتخزين وإدارة بيانات الطلاب ودرجاتهم، مع إمكانية إضافة وحذف وتحديث معلومات الطلاب. [...]

# 1. الهياكل البيانية: [...]
# فهرس رئيسي لتخزين جميع الطلاب [...]
# المفتاح سيكون اسم الطالب، والقيمة ستكون فهرس آخر بمعلومات الطالب [...، ...]
طلاب = {"الاسم": "لابتوب", "الدرجات": 1200, "كمية": 50} # تعريف فهرس فارغ لتخزين بيانات الطلاب [5، ...]
  #-----------------------------------------------------------------------------------------------------------------------------------
# 2. الدوال: [...]

# دالة لحساب متوسط درجات الطالب [...]
دالة حساب_متوسط_الدرجات(درجات): # [10، ...] تستقبل هذه الدالة مصفوفة من الدرجات
    اذا طول(درجات) == 0: # [1] تحقق أولاً إذا كانت المصفوفة فارغة باستخدام طول(درجات)، لترجع 0.0 لتجنب القسمة على صفر.
        ارجع 0.0 # [2] # استخدام 0.0 لضمان نتيجة عشرية (عدد عشري)
    مجموع_الدرجات = 0.0 # البدء بقيمة عشرية لضمان دقة الحساب في القسمة
    # استخدام حلقة لاجل للتكرار عبر درجات طالب معين لحساب المجموع [8، ...]
    لاجل درجة في درجات: # [8، 4] ستخدم حلقة لاجل للتكرار على كل درجة في مصفوفة درجات، وتقوم بعملية إسناد رجعي مجموع_الدرجات += درجة لجمع الدرجات
        مجموع_الدرجات += درجة # [1]
    ارجع مجموع_الدرجات \ طول(درجات) # [2، 3، 10] أخيراً، ترجع الدالة متوسط الدرجات بقسمة مجموع_الدرجات على طول(درجات)
  #-----------------------------------------------------------------------------------------------------------------------------------
# دالة لإضافة طالب جديد [...]
دالة إضافة_طالب(): # تطلب من المستخدم إدخال اسم الطالب، [10، لاجل ب في مدى(س): تُستخدم هذه الحلقة في دوال مثل إضافة_طالب() وتحديث_درجات_طالب() للتكرار بعدد محدد من المرات (مثلاً، عدد الدرجات التي يريد المستخدم إدخالها).]
    اطبع("--- إضافة طالب جديد ---") # [1]
    اسم_الطالب = ادخل("أدخل اسم الطالب: ") # [1]
    
    اذا اسم_الطالب في طلاب.مفاتيح(): # التحقق مما إذا كان الطالب موجوداً بالفعلظ، باستخدام اسم_الطالب في طلاب.مفاتيح() [15، 5]
        اطبع(م"الطالب '{اسم_الطالب}' موجود بالفعل في النظام.") # [3]
        ارجع # [2]
    
    مصفوفة_الدرجات = [] # [3]
      #-----------------------------------------------------------------------------------------------------------------------------------
    	#تستخدم حلقات بينما مع كتل حاول وخلل لضمان إدخال أرقام صالحة لعدد الدرجات وللدرجات نفسها، حيث يتم تحويل الإدخال إلى رقم عشري باستخدام عشري()
    بينما صح: # حلقة بينما للتأكد من إدخال رقم صحيح لعدد الدرجات [4]
        عدد_الدرجات_للاضافة_كنص = ادخل("كم عدد الدرجات التي تود إضافتها؟ (ادخل 0 إذا لا يوجد): ")
        حاول: # [2]
            عدد_الدرجات_للاضافة = عشري(عدد_الدرجات_للاضافة_كنص) # تحويل المدخل إلى رقم عشري [5]
            اذا عدد_الدرجات_للاضافة >= 0:
                توقف # [4]
            والا: # [6]
                اطبع("إدخال غير صالح. الرجاء إدخال رقم موجب أو صفر.")
        خلل: # [2]
            اطبع("إدخال غير صالح. الرجاء إدخال رقم.")
    #-----------------------------------------------------------------------------------------------------------------------------------
    # استخدام حلقة لاجل لإدخال الدرجات واحدة تلو الأخرى [8، ...]
    لاجل _ في مدى(عشري(عدد_الدرجات_للاضافة)): # [6] ستخدم حلقة لاجل للتكرار بعدد الدرجات المطلوبة، وتجمع كل درجة مدخلة في مصفوفة_الدرجات باستخدام مصفوفة_الدرجات.اضف(درجة_مدخلة)
        بينما صح: # حلقة بينما للتأكد من إدخال رقم صحيح للدرجة [4]
            درجة_مدخلة_كنص = ادخل(م"أدخل الدرجة رقم {عشري(_)+1}: ") # استخدام النص المنسق [3]
            حاول: # [2]
                درجة_مدخلة = عشري(درجة_مدخلة_كنص) # تحويل المدخل إلى رقم عشري [5]
                مصفوفة_الدرجات.اضف(درجة_مدخلة) # الإسناد: إضافة الدرجة للمصفوفة [4، ستخدم دالة .اضف() للمصفوفات لإضافة عناصر جديدة إليها (مثل مصفوفة_الدرجات.اضف(درجة_مدخلة)]
                توقف # [4]
            خلل: # [2]
                اطبع("إدخال غير صالح. الرجاء إدخال رقم للدرجة.")
  #-----------------------------------------------------------------------------------------------------------------------------------
    # الإسناد: إنشاء فهرس الطالب وإضافته إلى الفهرس الرئيسي [3، يُستخدم عامل الإسناد = لتعيين القيم للمتغيرات (مثل طلاب = {}) ولتحديث قيم المفاتيح في الفهارس (مثل طلاب[اسم_الطالب] = ...). ]
    طلاب[اسم_الطالب] = {"الاسم": اسم_الطالب, "الدرجات": مصفوفة_الدرجات} # [5، ...]  تقوم بعملية الإسناد طلاب[اسم_الطالب] = {"الاسم": اسم_الطالب, "الدرجات": مصفوفة_الدرجات} لإضافة الطالب الجديد إلى الفهرس الرئيسي طلاب.
    اطبع(م"الطالب '{اسم_الطالب}' تم إضافته بنجاح.") # [3]
  #-----------------------------------------------------------------------------------------------------------------------------------
# دالة لحذف طالب موجود [...]
دالة حذف_طالب(): # [10، ...] تطلب من المستخدم اسم الطالب المراد حذفه
    اطبع("--- حذف طالب ---")
    اسم_الطالب = ادخل("أدخل اسم الطالب المراد حذفه: ") # [1]
    		# ▪ ملاحظة خاصة بالحذف: بما أن احذف س تُستخدم لإزالة متغير بالكامل وليست لحذف مفتاح داخل فهرس بشكل صريح في المصادر، فإننا نستخدم هنا أسلوباً منطقياً لتمثيل الحذف: يتم إنشاء فهرس طلاب_جدد، وتتم حلقة لاجل على طلاب.مفاتيح() لإضافة جميع الطلاب باستثناء الطالب المراد حذفه إلى طلاب_جدد. في النهاية، يتم إسناد طلاب إلى طلاب_جدد، مما يزيل الطالب فعلياً من النظام.
    اذا اسم_الطالب في طلاب.مفاتيح(): # [15، 5] تتحقق من وجود الطالب في طلاب.مفاتيح()
        # ملاحظة: عبارة 'احذف س' في لغة ألف5 تُستخدم لإزالة متغير بالكامل [1]. | لإزالة عنصر (مفتاح-قيمة) من فهرس، لا توجد دالة صريحة مذكورة في المصادر (مثل 'del dict[key]' في بايثون). |  لغرض هذا المثال المفهومي، سنقوم بإنشاء فهرس جديد لا يحتوي على الطالب المحذوف، |  هو تمثيل منطقي لعملية الحذف، مع العلم أنها قد لا تكون الطريقة الأكثر كفاءة برمجياً.
        طلاب_جدد = {}
        # استخدام حلقة لاجل للتكرار عبر مفاتيح الفهرس الحالي [8، 5]
        لاجل مفتاح في طلاب.مفاتيح(): # [7]
            اذا مفتاح != اسم_الطالب: # [8]
                طلاب_جدد[مفتاح] = طلاب[مفتاح] # [3، 5]
        طلاب = طلاب_جدد # الإسناد: إعادة إسناد الفهرس الرئيسي بالفهرس الجديد [1]
        اطبع(م"الطالب '{اسم_الطالب}' تم حذف معلوماته من النظام بنجاح.") # [3]
    والا: # [6]
        اطبع(م"الطالب '{اسم_الطالب}' غير موجود في النظام.") # [3] 
  #-----------------------------------------------------------------------------------------------------------------------------------

# دالة لتحديث درجات طالب [...]
دالة تحديث_درجات_طالب(): # [10، تطلب اسم الطالب وتتحقق من وجوده]
    اطبع("--- تحديث درجات طالب ---")
    اسم_الطالب = ادخل("أدخل اسم الطالب المراد تحديث درجاته: ") # [1]
    
    اذا اسم_الطالب في طلاب.مفاتيح(): # [15، 5]
        طالب_موجود = طلاب[اسم_الطالب] # [7]
        اطبع(م"الدرجات الحالية لـ {طالب_موجود['الاسم']}: {طالب_موجود['الدرجات']}") # [3]  تعرض الدرجات الحالية للطالب ℹ️
        
        بينما صح: # حلقة بينما للتأكد من إدخال رقم صحيح لعدد الدرجات الجديدة [4]
            عدد_الدرجات_للتحديث_كنص = ادخل("كم عدد الدرجات الجديدة التي تود إضافتها؟ (ادخل 0 إذا لا يوجد): ")
            حاول: # [2]
                عدد_الدرجات_للتحديث = عشري(عدد_الدرجات_للتحديث_كنص) # [5]
                اذا عدد_الدرجات_للتحديث >= 0:
                    توقف # [4]
                والا: # [6]
                    اطبع("إدخال غير صالح. الرجاء إدخال رقم موجب أو صفر.")
            خلل: # [2]
                اطبع("إدخال غير صالح. الرجاء إدخال رقم.")
        
        اذا عدد_الدرجات_للتحديث > 0: # [6]
            اطبع("الرجاء إدخال الدرجات الجديدة واحدة تلو الأخرى:")
            لاجل _ في مدى(عشري(عدد_الدرجات_للتحديث)): # [6]
                بينما صح: # حلقة بينما للتأكد من إدخال رقم صحيح للدرجة [4]
                    درجة_مدخلة_كنص = ادخل(م"أدخل الدرجة الجديدة رقم {عشري(_)+1}: ") # [3]
                    حاول: # [2]
                        درجة_مدخلة = عشري(درجة_مدخلة_كنص) # [5]
                        طالب_موجود["الدرجات"].اضف(درجة_مدخلة) # الإسناد: إضافة الدرجة للمصفوفة [4، ...]
                        توقف # [4]
                    خلل: # [2]
                        اطبع("إدخال غير صالح. الرجاء إدخال رقم للدرجة.")
            اطبع(م"تم تحديث درجات الطالب '{اسم_الطالب}' بنجاح. الدرجات الجديدة: {طالب_موجود['الدرجات']}") # [3]
        والا: # [6]
            اطبع(م"لم يتم إضافة أي درجات جديدة للطالب '{اسم_الطالب}'.") # [3]
    والا: # [6]
        اطبع(م"الطالب '{اسم_الطالب}' غير موجود في النظام.") # [3]
  #-----------------------------------------------------------------------------------------------------------------------------------
# دالة لعرض معلومات طالب محدد [...] 🔼
دالة عرض_معلومات_طالب(): # [10، ...]
    اطبع("--- عرض معلومات طالب ---")
    اسم_الطالب = ادخل("أدخل اسم الطالب لعرض معلوماته: ") # [1] ▪ تطلب اسم الطالب وتتحقق من وجوده 
    
    اذا اسم_الطالب في طلاب.مفاتيح(): # [15، 5]
        طالب_موجود = طلاب[اسم_الطالب] # [7]
        اطبع(م"الاسم: {طالب_موجود['الاسم']}") # [3]
        اطبع(م"الدرجات: {طالب_موجود['الدرجات']}") # [3] تعرض اسم الطالب ودرجاته باستخدام النصوص المنسقة م""
        متوسط = حساب_متوسط_الدرجات(طالب_موجود['الدرجات']) # استدعاء دالة لحساب المتوسط [ستدعي الدالة حساب_متوسط_الدرجات() لطباعة متوسط درجات الطالب.]
        اطبع(م"متوسط الدرجات: {متوسط}") # [3]
    والا: # [6]
        اطبع(م"الطالب '{اسم_الطالب}' غير موجود في النظام.") # [3]
  #-----------------------------------------------------------------------------------------------------------------------------------
# دالة لعرض جميع الطلاب المسجلين [...] 🙄
دالة عرض_جميع_الطلاب(): # [10، ...]
    اطبع("--- قائمة جميع الطلاب ---")
    اذا طول(طلاب) == 0: # [1]
        اطبع("لا يوجد طلاب مسجلون في النظام حالياً.")
        ارجع # [2] تتحقق إذا كان الفهرس طلاب فارغاً
      #---------------------------------------------------------------------------------------------------------------------------------
    # استخدام حلقة (لاجل) للتكرار عبر قائمة الطلاب (مفاتيح الفهرس). [8، 5، تستخدم حلقة لاجل للتكرار على طلاب.مفاتيح() (أسماء الطلاب) وتعرض تفاصيل كل طالب (الاسم، الدرجات، والمتوسط) باستخدام الدالة حساب_متوسط_الدرجات().]
    لاجل اسم_طالب في طلاب.مفاتيح(): # [7]
        طالب_موجود = طلاب[اسم_طالب] # [7]
        اطبع("--------------------")
        اطبع("الاسم: {طالب_موجود['الاسم']}") # [3]
        اطبع("الدرجات: {طالب_موجود['الدرجات']}") # [3]
        متوسط = حساب_متوسط_الدرجات(طالب_موجود['الدرجات']) # [...]
        اطبع("متوسط الدرجات: {متوسط}") # [3]
    اطبع("--------------------")
  #-----------------------------------------------------------------------------------------------------------------------------------
# 3. الحلقات التكرارية: حلقة بينما لإنشاء قائمة تفاعلية [...]
دالة تشغيل_النظام(): # [10، ...]
    بينما صح: # حلقة بينما لتشغيل القائمة الرئيسية باستمرار حتى يختار المستخدم الخروج [9، بينما صح: تُستخدم هذه الحلقة في الدالة تشغيل_النظام() لإنشاء قائمة تفاعلية تظهر للمستخدم باستمرار. تسمح هذه الحلقة للمستخدم باختيار مهام مختلفة (إضافة، عرض، تحديث، حذف) حتى يختار الخروج من البرنامج باستخدام الخيار "6" والذي يؤدي إلى تنفيذ توقف]
        اطبع("\n--- نظام إدارة معلومات الطلاب ---")
        اطبع("1. إضافة طالب جديد")
        اطبع("2. عرض معلومات طالب")
        اطبع("3. تحديث درجات طالب")
        اطبع("4. حذف طالب")
        اطبع("5. عرض جميع الطلاب")
        اطبع("6. الخروج")
        
        اختيار = ادخل("الرجاء إدخال رقم الخيار: ") # [1]

        اذا اختيار == "1": # [6]
            إضافة_طالب()
        اواذا اختيار == "2": # [6]
            عرض_معلومات_طالب()
        اواذا اختيار == "3": # [6]
            تحديث_درجات_طالب()
        اواذا اختيار == "4": # [6]  كما ذكرنا في دالة حذف_طالب()، فإن عبارة احذف س تُستخدم لإزالة متغير. لتمثيل حذف الطالب من الفهرس، تم اتباع طريقة منطقية بإعادة بناء الفهرس دون الطالب المحذوف، نظراً لعدم وجود دالة صريحة في المصادر لحذف مفتاح من الفهرس مباشرة.
            حذف_طالب() 
        اواذا اختيار == "5": # [6]
            عرض_جميع_الطلاب()
        اواذا اختيار == "6": # [6]
            اطبع("شكراً لاستخدامك النظام. إلى اللقاء!")
            توقف # استخدام توقف للخروج من حلقة بينما [4]
        والا: # [6]
            اطبع("خيار غير صالح. الرجاء المحاولة مرة أخرى.")
  #-----------------------------------------------------------------------------------------------------------------------------------
# تشغيل النظام [...]
تشغيل_النظام()